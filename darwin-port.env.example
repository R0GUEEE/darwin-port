# Copy to darwin-port.env and source it, or export values individually.
# Paths are illustrative; update them for your host.

# Apple SDK used by xclang and pxcodebuild.py
DARWIN_SDK=/opt/xcode/MacOSX.sdk

# macOS deployment target and clang triple
DARWIN_MINOS=15.0
DARWIN_TARGET=arm64-apple-macos15.0

# Host compiler to drive (must include Mach-O support and find ld64.lld)
HOST_CLANG=clang

# Optional runtime search roots for darwinld
# DS_SYSROOT=/opt/darwin-root
# DS_LIB_PATH=/opt/darwin-root/usr/lib:/opt/darwin-root/usr/local/lib

# Optional developer directory reported to guest Xcode tools
# DEVELOPER_DIR=/opt/Xcode.app/Contents/Developer

# Select setup doctor requirements: core or full (default: full)
# DARWIN_PORT_PROFILE=full

# Optional: doctor reads this config file, defaulting to repo/darwin-port.env
# DARWIN_PORT_CONFIG=/path/to/darwin-port.env
